--- a/arch/arm/dts/rk3566-nanopi-r3s-u-boot.dtsi
+++ b/arch/arm/dts/rk3566-nanopi-r3s-u-boot.dtsi
@@
 / {
     chosen {
-        u-boot,spl-boot-order = "same-as-spl", &sdhci;
+        /* сначала microSD (mmc@fe2b0000), затем eMMC (mmc@fe310000) */
+        u-boot,spl-boot-order = &sdmmc0, &sdhci;
     };
 };
+
+/* SD-контроллер и его пины должны быть доступны в SPL */
+&sdmmc0 {
+    bootph-pre-ram;
+    bootph-some-ram;
+    /* при капризных картах помогает: */
+    /* u-boot,spl-fifo-mode; */
+};
+
+&sdmmc0_bus4 {
+    bootph-pre-ram;
+};
+
+&sdmmc0_clk {
+    bootph-pre-ram;
+};
+
+&sdmmc0_cmd {
+    bootph-pre-ram;
+};
+
+&sdmmc0_det {
+    bootph-pre-ram;
+};
+
+/* питание слота — иначе SPL может не увидеть карту */
+&vcc3v3_sys {
+    bootph-pre-ram;
+};
+
+&vccio_sd {
+    bootph-pre-ram;
+};
